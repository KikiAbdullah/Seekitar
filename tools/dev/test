#!/usr/bin/env bash
# Run the PHPUnit suite for seekitar-server.
#
# `artisan test` shells out to a subprocess, which the WASM runtime cannot do,
# so we invoke PHPUnit's Application directly in-process instead.
#
#   ./tools/dev/test
#   ./tools/dev/test --filter=StoreTest
#   ./tools/dev/test --testsuite=Feature
set -euo pipefail

DEV_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SERVER_DIR="$(cd "$DEV_DIR/../../seekitar-server" && pwd)"

# Seekitar hanya mendukung MySQL, dan test butuh server yang benar-benar
# berjalan. Tanpa pemeriksaan ini, kegagalan muncul sebagai stack trace WASM
# ("RuntimeError: unreachable") yang sama sekali tidak menjelaskan sebabnya.
DB_HOST="${DB_HOST:-127.0.0.1}"
DB_PORT="${DB_PORT:-3306}"
if ! (exec 3<>"/dev/tcp/$DB_HOST/$DB_PORT") 2>/dev/null; then
  cat >&2 <<MSG
Tidak ada server MySQL di $DB_HOST:$DB_PORT.

Seekitar memakai POINT SRID 4326, SPATIAL INDEX, SET, dan CHECK constraint,
sehingga test harus dijalankan terhadap MySQL 8.0.34+ — tidak ada lagi jalur
SQLite. Siapkan basis datanya:

  CREATE DATABASE seekitar_testing
    CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;

Tanpa server MySQL, yang masih bisa dijalankan di sini:

  ./tools/dev/ddl                  # DDL MySQL dari migrasi
  node tools/dev/check-mysql.mjs   # periksa SRID, ENUM/SET, CHECK, InnoDB
MSG
  exit 1
fi

# `--` memisahkan argumen skrip dari opsi Node; tanpa itu, argumen seperti
# `--filter=Foo` ditelan Node sebagai opsinya sendiri dan gagal.
ARGS_JSON=$(node -e '
  const a = process.argv.slice(1);
  process.stdout.write(JSON.stringify(["phpunit", "--configuration", "phpunit.xml", ...a]));
' -- "$@")

RUNNER=$(mktemp /tmp/seekitar-phpunit-XXXXXX.php)
trap 'rm -f "$RUNNER"' EXIT

cat > "$RUNNER" <<PHPEOF
<?php
chdir('$SERVER_DIR');
\$_SERVER['argv'] = json_decode(<<<'JSON'
$ARGS_JSON
JSON, true);
\$_SERVER['argc'] = count(\$_SERVER['argv']);

require '$SERVER_DIR/vendor/autoload.php';
exit((new PHPUnit\TextUI\Application())->run(\$_SERVER['argv']));
PHPEOF

exec "$DEV_DIR/php" "$RUNNER"
