APP_NAME=Seekitar
# Untuk PRODUKSI wajib: APP_ENV=production & APP_DEBUG=false (mencegah bocornya
# stack trace / detail SQL ke publik). Salin file ini sebagai .env lalu sesuaikan.
APP_ENV=production
APP_KEY=
JWT_SECRET=
APP_DEBUG=false
APP_URL=https://seekitar.id

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Seekitar HANYA mendukung MySQL 8.0.34+ (lihat DATABASE.md §1).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=seekitar
DB_USERNAME=root
DB_PASSWORD=

# Akun super-admin (dibuat RolesAndPermissionsSeeder di SEMUA environment).
# Default: Sinta Wijaya. WAJIB diganti kata sandinya sebelum deploy produksi.
SEEKITAR_SUPER_ADMIN_PHONE=6280000000001
SEEKITAR_SUPER_ADMIN_EMAIL=superadmin@seekitar.test
SEEKITAR_SUPER_ADMIN_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Wajib true di produksi HTTPS (cookie sesi tidak dikirim lewat HTTP).
SESSION_SECURE_COOKIE=true

# Origin web yang diizinkan CORS — WAJIB diisi di produksi (jangan '*':
# kombinasi wildcard + credentials tidak aman).
FRONTEND_URL=https://seekitar.id
CORS_SUPPORTS_CREDENTIALS=true

# IP reverse proxy/load balancer yang dipercaya untuk header X-Forwarded-*
# (nginx, Cloudflare, dsb.). '*' = percaya semua proxy; isi daftar IP bila
# ingin lebih ketat. Diperlukan agar HTTPS/ip()/rate-limit benar di produksi.
TRUSTED_PROXIES=*

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Produksi WAJIB queue worker berjalan:
#   php artisan queue:work redis --queue=high,default --tries=3 --backoff=2,10
# (dev bisa memakai `database` — tanpa Redis, cukup worker yang sama.
#  JANGAN pakai `sync` di produksi: job OTP akan memblokir request.)
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# Produksi: log berotasi harian dan jangan tulis debug.
LOG_CHANNEL=daily
LOG_LEVEL=warning
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- WhatsApp (OTP) ----------------------------------------------------------
# Driver: log (dev, default) | email | kirimwa | baileys
WHATSAPP_DRIVER=log
# Driver OTP bila WHATSAPP_DRIVER kosong (alias lama). `log` menulis OTP ke
# log (dev saja); `email` mengirim ke OTP_EMAIL_TO.
OTP_DELIVERY=log
OTP_EMAIL_TO=

# Baileys gateway (WHATSAPP_DRIVER=baileys) — Node sidecar:
#   cd seekitar-server/whatsapp-gateway && npm install && npm start
BAILEYS_URL=http://127.0.0.1:3001
# Token HARUS sama dengan BAILEYS_TOKEN di service Node (wajib di produksi).
BAILEYS_TOKEN=
BAILEYS_TIMEOUT=10
# Jalur cepat (socket): isi URL Redis agar OTP dikirim lewat Redis pub/sub
# (koneksi persisten, tanpa HTTP handshake per pesan) — gateway Node harus
# diset REDIS_URL yang sama. Kosongkan untuk memakai HTTP biasa.
BAILEYS_REDIS_URL=redis://127.0.0.1:6379
BAILEYS_CHANNEL_SEND=seekitar:wa:send

# Akun panel admin produksi. Seeder menolak nilai contoh/default.
SEEKITAR_SUPER_ADMIN_PHONE=
SEEKITAR_SUPER_ADMIN_EMAIL=
SEEKITAR_SUPER_ADMIN_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
